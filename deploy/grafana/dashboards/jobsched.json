        "type": "prometheus",
        "uid": "jobsched-prom"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "jobsched-prom"
          },
          "editorMode": "code",
          "expr": "jobsched_workers_busy",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": null,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Pool utilisation",
      "description": "Mean busy fraction across the pool over 1m. Derived from busy-seconds counters (D-037). Both sides are wrapped in sum() so their label sets match: sum() strips all labels, and PromQL binary operations require identical label sets on both operands.",
      "datasource": {
        "type": "prometheus",
        "uid": "jobsched-prom"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "jobsched-prom"
          },
          "editorMode": "code",
          "expr": "sum(rate(jobsched_worker_busy_seconds_total[1m])) / sum(jobsched_workers_total)",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.75
              },
              {
                "color": "red",
                "value": 0.95
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Failure rate (5m)",
      "description": "Share of terminal jobs that failed. Ratio of counters computed in PromQL, not stored (D-046). Shows No data when nothing has completed \u2014 0/0 is undefined, not zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "jobsched-prom"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "jobsched-prom"
          },
          "editorMode": "code",
          "expr": "sum(rate(jobsched_jobs_completed_total{status=\"failed\"}[5m])) / sum(rate(jobsched_jobs_completed_total[5m]))",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Job throughput",
      "description": "Jobs per second. Counters differentiated with rate() so bursts show as spikes rather than changes in slope (D-046).",
      "datasource": {
        "type": "prometheus",
        "uid": "jobsched-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "jobsched-prom"
          },
          "editorMode": "code",
          "expr": "sum by (status) (rate(jobsched_jobs_completed_total[1m]))",
          "range": true,
          "instant": false,
          "refId": "A",
          "legendFormat": "{{status}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "jobsched-prom"
          },
          "editorMode": "code",
          "expr": "rate(jobsched_jobs_submitted_total[1m])",
          "range": true,
          "instant": false,
          "refId": "A",
          "legendFormat": "submitted"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": null,
          "max": null,
          "decimals": null,
          "color": {
            "mode": "palette-classic"
