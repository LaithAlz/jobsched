    {
      "id": 11,
      "type": "timeseries",
      "title": "Attempts by outcome",
      "description": "'failed' means the container ran and exited non-zero. 'error' means it never ran \u2014 an infrastructure problem (D-024). Watching these diverge separates broken jobs from a broken daemon.",
      "datasource": {
        "type": "prometheus",
        "uid": "jobsched-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "jobsched-prom"
          },
          "editorMode": "code",
          "expr": "sum by (outcome) (rate(jobsched_job_attempts_total[1m]))",
          "range": true,
          "instant": false,
          "refId": "A",
          "legendFormat": "{{outcome}}"
        }
      ],
